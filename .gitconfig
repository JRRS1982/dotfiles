# Shared git config — routing only. Symlinked from the dotfiles repo.
#
# Identity is NOT set here on purpose (fail-closed): a repo whose remote
# matches none of the rules below will make git refuse to commit until you
# set user.name/user.email, instead of silently using a wrong identity.
#
# Identity is selected by REMOTE URL via hasconfig (requires git >= 2.36),
# so it is correct regardless of where the repo lives on disk.

[pull]
	rebase = false

# Drop remote-tracking refs whose branch is gone from the server, on every
# fetch. Without it `origin/*` only ever grows: 103 dead refs had piled up
# across 25 repos by 2026-09-23, and `git branch -vv | grep ': gone]'` - the
# usual way to find merged branches - only tells the truth once this is on.
#
# The cost: a remote-tracking ref is the last local pointer to a branch
# someone deletes server-side. Pruning removes the ref AND its reflog, so an
# UNMERGED branch deleted on the remote becomes unrecoverable here once gc
# runs. Merged branches are unaffected - their commits stay reachable from
# master. Deliberately NOT setting fetch.pruneTags, which would delete local
# tags that are absent from the remote.
[fetch]
	prune = true

# Credentials are selected by REMOTE URL too, not by whichever gh account
# happens to be active. `gh auth git-credential` always hands back the ACTIVE
# account's token, so a bare `git push` in a work repo while the personal
# account is active fails as "remote: Repository not found" - naming the repo
# rather than the account, which sends you looking in the wrong place. ghsync
# in .zsh_aliases keeps the active account right for the `gh` CLI itself, but
# it is a zsh function: cron, scripts and agent shells do not have it.
#
# useHttpPath is what lets the org-scoped sections below match at all - without
# it git only matches credential config on protocol and host, so the path is
# never even looked at. The empty `helper =` in each org section resets the
# inherited host-level helper rather than adding to it, so exactly one runs.
# Any other github.com org falls through to the host section and the active
# account, which is the right default for a fork or a client org.
#
# Check what a URL resolves to with:
#   git config --get-urlmatch credential https://github.com/mvfglobal/x.git
[credential "https://github.com"]
	useHttpPath = true
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://github.com/mvfglobal"]
	helper =
	helper = "!f() { test \"$1\" = get && printf 'username=JRRSMVF\\npassword=%s\\n' \"$(/usr/bin/gh auth token --user JRRSMVF)\"; }; f"
[credential "https://github.com/JRRS1982"]
	helper =
	helper = "!f() { test \"$1\" = get && printf 'username=JRRS1982\\npassword=%s\\n' \"$(/usr/bin/gh auth token --user JRRS1982)\"; }; f"
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

# Personal — any JRRS1982 remote (https or ssh)
[includeIf "hasconfig:remote.*.url:https://github.com/JRRS1982/**"]
	path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@github.com:JRRS1982/**"]
	path = ~/.gitconfig-personal

# Work — MVF repos on Bitbucket and GitHub (scp-style and https). hasconfig
# globs do not cross "/" with a bare *, so anchor the org path explicitly
# rather than **mvf**.
[includeIf "hasconfig:remote.*.url:git@bitbucket.org:mvfglobal/**"]
	path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://bitbucket.org/mvfglobal/**"]
	path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:git@github.com:mvfglobal/**"]
	path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://github.com/mvfglobal/**"]
	path = ~/.gitconfig-work
