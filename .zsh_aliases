# Shell aliases & helper functions — symlinked from the dotfiles repo, sourced by ~/.zshrc.

# JS: gp helper
# WHAT: push the local branch to the remote origin (creating upstream if needed)
# WHY: makes life easier by reducing typing.
# HOW: i.e. "gp"
unalias gp 2>/dev/null
gp() {
  local branch=$(git rev-parse --abbrev-ref HEAD)
  if git ls-remote --exit-code --heads origin "$branch" &>/dev/null; then
    echo "Branch '$branch' already exists on the remote. Pushing updates..."
  else
    echo "Branch '$branch' does not exist on the remote. Creating it now..."
  fi
  git push --set-upstream origin "$branch"
}

# JS: gc helper
# WHAT: commit all staged changes, prefixing the message with the branch name.
# WHY: makes life easier
# HOW: i.e. "gc add new button" on branch GOLD-123 -> "GOLD-123: add new button"
unalias gc 2>/dev/null
gc() {
  branch=$(git rev-parse --abbrev-ref HEAD)
  git commit -m "$branch: $*"
}

# JS: gcn helper — like gc but skips pre-commit hooks
unalias gcn 2>/dev/null
gcn() {
  branch=$(git rev-parse --abbrev-ref HEAD)
  git commit -n -m "$branch: $*"
}

# WHAT: alias to manage the dotfiles repo from anywhere
# WHY: quick add/commit of tracked config
# HOW: dotfiles status | dotfiles add ~/.zshrc | dotfiles commit -m "..."
alias dotfiles="git -C $HOME/PersonalProjects/dotfiles"

# JS: gh account auto-switch
# WHAT: keeps gh's ACTIVE account matching the repo you are standing in.
# WHY: ~/.gitconfig already picks the right commit identity per remote
#      (includeIf hasconfig:remote.*.url), but that only sets user.name and
#      user.email. Which GitHub account actually authenticates is gh's active
#      account — and because the credential helper is `gh auth git-credential`,
#      a bare `git push` uses it too. A mismatch shows up as
#      "remote: Repository not found" on a repo you own, which is confusing
#      because the error names the repo rather than the account.
# HOW: automatic on cd, and again before any gh command.
#      `ghwho` to see where you stand, `ghsync -v` to see what it decided.

# Map a remote to the account that owns it. Mirrors the rules in ~/.gitconfig —
# keep the two in step. Returns 1 for an unrecognised remote so that anything
# else (a fork, a client org, no remote at all) is left alone rather than
# guessed at.
_gh_account_for_repo() {
  local url
  url=$(git config --get remote.origin.url 2>/dev/null) || return 1
  # Anchored at the start of the URL rather than matched anywhere in it, so a
  # remote like https://elsewhere.example/github.com/JRRS1982/x cannot claim an
  # account it does not own.
  case "$url" in
    https://github.com/JRRS1982/*|git@github.com:JRRS1982/*|ssh://git@github.com/JRRS1982/*)
      print JRRS1982 ;;
    https://github.com/mvfglobal/*|git@github.com:mvfglobal/*|ssh://git@github.com/mvfglobal/*)
      print JRRSMVF ;;
    *) return 1 ;;
  esac
}

# The active account, read straight from gh's config file. `gh auth status`
# would also say, but it makes a network call — far too slow to hang off every
# cd. The pattern matches `user:` and not `users:`, which sit at the same indent.
_gh_active_account() {
  grep -E "^[[:space:]]*user:" "${GH_CONFIG_DIR:-$HOME/.config/gh}/hosts.yml" 2>/dev/null \
    | awk '{print $2}' | head -1
}

# Switch only on a real mismatch: `gh auth switch` rewrites hosts.yml, so doing
# it unconditionally would mean a disk write on every directory change.
ghsync() {
  local want have
  if ! want=$(_gh_account_for_repo); then
    [[ "$1" == "-v" ]] && print "gh: no rule for this remote, leaving $(_gh_active_account) active"
    return 0
  fi
  have=$(_gh_active_account)
  if [[ "$want" != "$have" ]]; then
    if command gh auth switch --user "$want" >/dev/null 2>&1; then
      print "gh: switched to $want"
    else
      print "gh: could not switch to $want — is it logged in? (gh auth login)" >&2
    fi
  elif [[ "$1" == "-v" ]]; then
    print "gh: already $have"
  fi
}

# Wrapping gh as well as hooking cd, because a long-lived shell can drift if the
# account is changed from somewhere else. `command gh` avoids recursing back
# into this function. `gh auth ...` is exempt — switching underneath someone who
# is explicitly managing accounts would be obnoxious.
unalias gh 2>/dev/null
gh() {
  [[ "$1" != "auth" ]] && ghsync
  command gh "$@"
}

# WHAT: who am I about to act as?
# HOW: ghwho
unalias ghwho 2>/dev/null
ghwho() {
  local want
  if want=$(_gh_account_for_repo); then
    print "repo wants:  $want"
  else
    print "repo wants:  (no rule for this remote)"
  fi
  print "gh active:   $(_gh_active_account)"
  print "git author:  $(git config user.name 2>/dev/null) <$(git config user.email 2>/dev/null)>"
}

autoload -Uz add-zsh-hook 2>/dev/null && add-zsh-hook chpwd ghsync
