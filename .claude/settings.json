{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(~/.zshrc)",
      "Read(~/.claude/*)",
      "Read(~/Projects/*)",
      "Read(~/PersonalProjects/*)",
      "Bash(git add *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(npx biome *)",
      "Bash(pnpm audit *)",
      "Bash(pnpm build *)",
      "Bash(pnpm check *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm jest *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm prisma *)",
      "Bash(pnpm test *)",
      "Bash(pnpm tsc *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm verify *)",
      "Bash(pnpm dev*)",
      "Bash(pnpm start*)",
      "Bash(pnpm preview*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(cd *)",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__claude_ai_Atlassian_Rovo__getJiraIssue",
      "mcp__plugin_claude-mem_mcp-search__get_observations"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/home/jeremyadmin/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "context7@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "warp@claude-code-warp": false,
    "code-simplifier@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "outputStyle": "simplified-technical-english",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
